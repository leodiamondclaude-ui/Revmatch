# --- Required ---------------------------------------------------------------
# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL, used in QR codes and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional integrations (features show "not configured" without them) ----
# Server-only. Used to copy generated / library 3D models into your storage.
SUPABASE_SERVICE_ROLE_KEY=
# AI vehicle identification from photos (Claude vision)
ANTHROPIC_API_KEY=
# Existing 3D model search + download (https://sketchfab.com/settings/password -> API token)
SKETCHFAB_API_TOKEN=
# AI image-to-3D generation (https://www.meshy.ai/api)
MESHY_API_KEY=
# Model library: the scheduled job that prepares stock models ahead of time (Vercel Cron sends this as a bearer token)
CRON_SECRET=
# Library entries built per run (1-5)
LIBRARY_BATCH=2

# --- Limits and operations ---------------------------------------------------
# Daily AI calls per user (defaults: identify 12, lookup 30, agent 3, generate 2). Needs SUPABASE_SERVICE_ROLE_KEY.
# AI_LIMIT_IDENTIFY=12
# AI_LIMIT_LOOKUP=30
# AI_LIMIT_AGENT=3
# AI_LIMIT_GENERATE=2
# Background jobs run per cron tick (1-3)
JOB_BATCH=2
# Slack/Discord incoming webhook for error alerts (optional)
ERROR_WEBHOOK_URL=

# --- Legal pages ---------------------------------------------------------------
# Shown in the privacy policy and terms. Have a lawyer review those pages before launch.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
