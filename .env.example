# --- Required ---------------------------------------------------------------
# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL, used in QR codes and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional integrations (features show "not configured" without them) ----
# Server-only. Used to copy generated / library 3D models into your storage.
SUPABASE_SERVICE_ROLE_KEY=
# AI vehicle identification from photos (Claude vision)
ANTHROPIC_API_KEY=
# Existing 3D model search + download (https://sketchfab.com/settings/password -> API token)
SKETCHFAB_API_TOKEN=
# AI image-to-3D generation (https://www.meshy.ai/api)
MESHY_API_KEY=
